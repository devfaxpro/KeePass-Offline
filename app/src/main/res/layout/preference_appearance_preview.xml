<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="8dp" android:paddingBottom="16dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="26dp" app:cardElevation="0dp"
        app:strokeColor="?attr/atelierSeparator"
        app:cardBackgroundColor="?attr/colorPrimaryContainer" app:strokeWidth="1dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.kunzisoft.keepass.view.AtelierArtworkView
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/modern_preview" android:textSize="12sp"
                android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/modern_preview_title"
                android:textSize="26sp" android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/modern_preview_summary"
                android:textSize="14sp" android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
