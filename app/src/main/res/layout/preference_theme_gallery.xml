<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingLeft="20dp" android:paddingRight="20dp"
    android:paddingTop="12dp" android:paddingBottom="16dp" android:orientation="vertical">
    <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSurface"/>
    <TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant"/>
    <LinearLayout android:id="@+id/theme_gallery" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="vertical"/>
</LinearLayout>
