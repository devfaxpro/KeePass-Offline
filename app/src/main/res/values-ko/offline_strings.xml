<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="offline_backup_title">백업 및 복원</string>
    <string name="offline_backup_summary">동일한 마스터 인증 정보로 암호화된 사본을 저장합니다. 오프라인으로 보관하려면 기기 저장소나 USB 저장 장치를 선택하세요.</string>
    <string name="offline_backup_last">이 기기에서 마지막으로 성공한 복사: %1$s</string>
    <string name="offline_backup_never">복사 기록 없음</string>
    <string name="offline_restore_help">백업 확인 또는 복원: 데이터베이스를 잠근 후 데이터베이스 열기에서 사본을 선택하세요. 잠금을 해제하기 전에 읽기 전용 모드를 켜세요. 원본을 교체하기 전에 항목을 확인하세요. 설정된 키 파일이나 하드웨어 키는 여전히 필요합니다.</string>
    <string name="offline_backup_create">백업 만들기</string>
    <string name="offline_review_title">비밀번호 점검</string>
    <string name="offline_review_running">기기에서 확인 중…</string>
    <string name="offline_review_summary">확인한 비밀번호: %1$d개. 검토할 항목: %2$d개.</string>
    <string name="offline_review_scope">재사용되거나 12자 미만이거나 동일한 문자만 반복된 비밀번호를 기기에서 확인합니다. 휴지통과 템플릿은 제외합니다. 유출 여부를 확인하거나 강도를 보장하지 않습니다. 항목을 눌러 검토하세요.</string>
    <string name="offline_review_reused">재사용됨</string>
    <string name="offline_review_short">짧거나 반복적임</string>
    <string name="offline_review_error">확인을 완료할 수 없습니다. 데이터베이스 잠금을 해제한 후 다시 시도하세요.</string>
    <string name="offline_review_untitled">제목 없는 항목</string>
    <string name="offline_more_options">메모 및 만료</string>
    <string name="offline_less_options">메모 및 만료 숨기기</string>
</resources>
